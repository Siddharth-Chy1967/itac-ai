LLM_PROVIDER=gemini            # gemini | ollama | anthropic
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.3
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_MODEL=claude-haiku-latest
ROUTER_MODEL_OVERRIDE=         # optional cheaper model just for skill routing
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
CHROMA_PATH=./data/chroma
UPLOAD_PATH=./data/uploads
EXPORT_PATH=./data/exports          # rendered .xlsx files served by /api/export/download
REPORTS_PATH=./data/reports         # report corpus ingested by `python -m app.rag.ingest`
MAX_RAG_CHUNKS=6
CHUNK_SIZE_TOKENS=700
CHUNK_OVERLAP_TOKENS=100
