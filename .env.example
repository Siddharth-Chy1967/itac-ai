# Chat model: openai | gemini | ollama. openai shares the bill reader's key and model
# (BILLS_LLM_API_KEY / gpt-6-luna) unless OPENAI_API_KEY / OPENAI_MODEL are set.
# ollama runs fully local, the fallback when there is no internet or no key.
LLM_PROVIDER=openai
# Comments must sit on their own line: a blank value takes the rest of the line.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=low
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.3
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_MODEL=claude-haiku-latest
ROUTER_MODEL_OVERRIDE=         # optional cheaper model just for skill routing
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
CHROMA_PATH=./data/chroma
UPLOAD_PATH=./data/uploads
EXPORT_PATH=./data/exports          # rendered .xlsx files served by /api/export/download
REPORTS_PATH=./data/reports         # report corpus ingested by `python -m app.rag.ingest`
MAX_RAG_CHUNKS=6
CHUNK_SIZE_TOKENS=700
CHUNK_OVERLAP_TOKENS=100

# --- Utility-bill extraction -------------------------------------------------
# Which model reads bills. Separate from LLM_PROVIDER above (that one drives chat).
# To switch to OpenAI, set the provider to openai and paste a key; the model
# defaults to gpt-6-luna. Answers are cached per provider+model, so switching
# never reuses another model's results.
#   ollama             local Ollama at OLLAMA_BASE_URL (model: BILLS_VLM_MODEL)
#   openai             OpenAI Responses API
#   openai_compatible  any /chat/completions endpoint, e.g. OpenRouter:
#                      BILLS_LLM_BASE_URL=https://openrouter.ai/api/v1
#                      BILLS_LLM_MODEL=openai/gpt-6-luna
BILLS_LLM_PROVIDER=ollama
BILLS_LLM_MODEL=                    # blank = provider default (openai: gpt-6-luna)
BILLS_LLM_API_KEY=                  # your OpenAI / OpenRouter key
BILLS_LLM_BASE_URL=                 # blank = provider default
BILLS_LLM_REASONING_EFFORT=medium   # none | low | medium | high
BILLS_LLM_IMAGES=auto               # auto | always | never (auto: hosted always;
                                    # local model only for scanned pages)
BILLS_DERIVED_COLUMNS=false         # true adds columns no bill prints (summed
                                    # Total kWh, MMBtu, cost per gallon)
# Local model. Install once:  ollama pull qwen2.5vl:latest
BILLS_VLM_MODEL=qwen2.5vl:latest
BILLS_TEXT_MODEL=                   # blank = reuse the VLM (one model in VRAM)
BILLS_NUM_CTX=16384
BILLS_MAX_NUM_CTX=32768
BILLS_TIMEOUT_SECONDS=900
BILLS_KEEP_ALIVE=15m
BILLS_OCR=true                      # RapidOCR on the CPU feeds exact characters
BILLS_OCR_DPI=300
BILLS_OCR_MIN_SCORE=0.5
BILLS_IMAGE_MAX_SIDE=1344           # lower if VRAM runs out
BILLS_IMAGE_TOKEN_BUDGET=6000
BILLS_MAX_ATTEMPTS=2
BILLS_PATH=./data/bills             # uploads, split bills and workbooks (safe to delete)
BILLS_CACHE_PATH=./data/bill_cache  # model answers, keyed by content hash. Kept OUTSIDE
                                    # BILLS_PATH on purpose: a few hundred KB of JSON, and
                                    # deleting it makes the model re-read every page and
                                    # answer differently, so the same PDF can group one run
                                    # and be refused the next.
BILLS_AMOUNT_TOLERANCE=0.02         # dollars; rounding slack for reconciliation

# Pre-build the embedder, Chroma collections and chat model at startup so the first
# message is fast. false loads them on the first request instead, which means waiting
# after you have already typed.
WARMUP_ON_STARTUP=true
